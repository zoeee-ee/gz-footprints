{
  "name": "gz-footprints",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "gz-footprints" }
  ]
}
